# 🩹🏰 Bandage Castle configuration
# Copy this file to .env and change the DATABASE_URL line.

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:change-me@localhost:3306/bandage_castle"

# Signs the session cookies. Any long random string will do for local development.
JWT_SECRET="dev-only-secret-change-me"

# PORT=3001

# Optional. Without it the API caches in memory.
# REDIS_URL="redis://localhost:6379"
