// Bandage Castle database schema 🏰
//
// The tbl_* tables predate Prisma (2022). Models map onto them with
// @@map / @map so the code can use camelCase. New tables are snake_case
// and plural.
//
// relationMode = "prisma": the legacy tables never had foreign keys, and
// adding them would mean cleaning up years of orphaned rows first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ---------------------------------------------------------------------------
// Legacy tables (2022)
// ---------------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  /// Legacy single role from 2022. Values: ADMIN, STAFF, OWNER.
  role         String    @default("STAFF") @db.VarChar(32)
  displayName  String?   @map("display_name") @db.VarChar(191)
  createdAt    DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  customer Customer?
  roles    UserRole[]

  ticketsAssigned Ticket[]        @relation("ticketAssignee")
  ticketsReported Ticket[]        @relation("ticketReporter")
  ticketComments  TicketComment[]

  @@map("tbl_user")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)

  @@index([token])
  @@map("tbl_password_reset")
}

model Customer {
  id          Int       @id @default(autoincrement())
  userId      Int?      @unique @map("user_id")
  title       String?   @db.VarChar(64)
  firstName   String?   @map("first_name") @db.VarChar(100)
  lastName    String?   @map("last_name") @db.VarChar(100)
  email       String?   @db.VarChar(191)
  /// raven | crystal ball | email
  contactPref String?   @default("raven") @map("contact_pref") @db.VarChar(32)
  lairAddress String?   @map("lair_address") @db.Text
  notes       String?   @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  user     User?     @relation(fields: [userId], references: [id])
  monsters Monster[]
  stays    Stay[]
  invoices Invoice[]

  @@map("tbl_customer")
}

model Monster {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  /// Free-text species from 2022. Use speciesId / species for new code.
  speciesName String?   @map("species") @db.VarChar(100)
  speciesId   Int?      @map("species_id")
  ownerId     Int?      @map("owner_id")
  birthDate   DateTime? @map("birth_date") @db.Date
  temperament String?   @db.VarChar(100)
  quirks      String?   @db.Text
  history     String?   @db.Text
  photoUrl    String?   @map("photo_url") @db.VarChar(255)
  /// IN_RESIDENCE | HOME | AVAILABLE | HIRED | RETIRED
  status      String?   @default("IN_RESIDENCE") @db.VarChar(32)
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  owner   Customer? @relation(fields: [ownerId], references: [id])
  species Species?  @relation(fields: [speciesId], references: [id])
  stays   Stay[]

  lairAssignments LairAssignment[]
  medicalRecords  MedicalRecord[]
  therapyPlans    TherapyPlan[]
  hiringListings  HiringListing[]

  @@index([ownerId])
  @@index([speciesId])
  @@map("tbl_monster")
}

model Stay {
  id             Int       @id @default(autoincrement())
  monsterId      Int       @map("monster_id")
  customerId     Int       @map("customer_id")
  /// BOARDING | TREATMENT | THERAPY | SURRENDER
  reason         String    @db.VarChar(32)
  /// BOOKED | CHECKED_IN | CHECKED_OUT | CANCELLED
  status         String?   @default("BOOKED") @db.VarChar(32)
  startDate      DateTime? @map("start_date") @db.Date
  expectedPickup DateTime? @map("expected_pickup") @db.Date
  checkedInAt    DateTime? @map("checked_in_at") @db.DateTime(0)
  checkedOutAt   DateTime? @map("checked_out_at") @db.DateTime(0)
  dailyRate      Decimal?  @default(10.00) @map("daily_rate") @db.Decimal(10, 2)
  notes          String?   @db.Text

  monster    Monster         @relation(fields: [monsterId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  invoices   Invoice[]
  extensions StayExtension[]

  @@index([monsterId])
  @@index([customerId])
  @@map("tbl_stay")
}

model Invoice {
  id         Int       @id @default(autoincrement())
  stayId     Int?      @map("stay_id")
  customerId Int       @map("customer_id")
  issuedAt   DateTime? @default(now()) @map("issued_at") @db.DateTime(0)
  dueDate    DateTime? @map("due_date") @db.Date
  total      Decimal?  @default(0.00) @db.Decimal(10, 2)
  /// UNPAID | PAID | VOID
  status     String?   @default("UNPAID") @db.VarChar(16)

  stay     Stay?         @relation(fields: [stayId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  lines    InvoiceLine[]
  payments Payment[]

  @@index([stayId])
  @@index([customerId])
  @@map("tbl_invoice")
}

model InvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  description String?  @db.VarChar(255)
  qty         Int?     @default(1)
  unitPrice   Decimal? @map("unit_price") @db.Decimal(10, 2)
  amount      Decimal? @db.Decimal(10, 2)
  /// STAY | TREATMENT | LATE_FEE | OTHER
  kind        String?  @default("OTHER") @db.VarChar(16)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("tbl_invoice_line")
}

model Payment {
  id        Int       @id @default(autoincrement())
  invoiceId Int       @map("invoice_id")
  amount    Decimal?  @db.Decimal(10, 2)
  /// GOLD | GEMS | IOU
  method    String?   @default("GOLD") @db.VarChar(16)
  paidAt    DateTime? @default(now()) @map("paid_at") @db.DateTime(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("tbl_payment")
}

model Raven {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  subject    String?   @db.VarChar(255)
  body       String?   @db.Text
  status     String?   @default("QUEUED") @db.VarChar(16)
  createdAt  DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  sentAt     DateTime? @map("sent_at") @db.DateTime(0)

  @@index([status])
  @@map("tbl_raven")
}

/// Monster Arena (on hold since Nov 2022).
model TournamentMatch {
  id          Int       @id @default(autoincrement())
  monsterAId  Int       @map("monster_a_id")
  monsterBId  Int       @map("monster_b_id")
  contest     String?   @default("ROAR") @db.VarChar(32)
  scheduledAt DateTime? @map("scheduled_at") @db.DateTime(0)
  winnerId    Int?      @map("winner_id")
  scoreA      Int?      @map("score_a")
  scoreB      Int?      @map("score_b")

  @@map("tbl_tournament_match")
}

// ---------------------------------------------------------------------------
// 2023+
// ---------------------------------------------------------------------------

/// A user can hold several roles (e.g. OWNER + OVERLORD). Replaces tbl_user.role.
model UserRole {
  userId    Int      @map("user_id")
  role      String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Species {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  slug          String   @unique @db.VarChar(100)
  description   String?  @db.Text
  /// Human-readable, e.g. "Goats, turnips, the occasional lost knight's packed lunch"
  diet          String   @db.VarChar(255)
  /// CARNIVORE | HERBIVORE | OMNIVORE | MINERAL | ETHEREAL
  dietType      String   @map("diet_type") @db.VarChar(32)
  mealsPerDay   Int      @default(2) @map("meals_per_day")
  portionKg     Decimal  @default(1.00) @map("portion_kg") @db.Decimal(6, 2)
  /// 1 (cuddly) .. 5 (do not make eye contact)
  dangerLevel   Int      @map("danger_level")
  tempMinC      Int      @map("temp_min_c")
  tempMaxC      Int      @map("temp_max_c")
  humidityMin   Int      @map("humidity_min")
  humidityMax   Int      @map("humidity_max")
  /// 0 = bright daylight, 100 = pitch black
  darkness      Int
  lifespanYears Int?     @map("lifespan_years")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  monsters         Monster[]
  incompatibleWith SpeciesCompatibility[] @relation("ruleFrom")
  incompatibleFrom SpeciesCompatibility[] @relation("ruleTo")

  @@map("species")
}

/// "Never house <species> next to <incompatibleSpecies>."
model SpeciesCompatibility {
  id                    Int      @id @default(autoincrement())
  speciesId             Int      @map("species_id")
  incompatibleSpeciesId Int      @map("incompatible_species_id")
  reason                String   @db.VarChar(255)
  createdAt             DateTime @default(now()) @map("created_at")

  species             Species @relation("ruleFrom", fields: [speciesId], references: [id], onDelete: Cascade)
  incompatibleSpecies Species @relation("ruleTo", fields: [incompatibleSpeciesId], references: [id], onDelete: Cascade)

  @@unique([speciesId, incompatibleSpeciesId])
  @@index([incompatibleSpeciesId])
  @@map("species_compatibility")
}

model Lair {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(100)
  /// NORTH_TOWER | DUNGEON | EAST_WING | MOAT | ROOFTOP | CELLAR
  wing         String   @db.VarChar(32)
  capacity     Int
  temperatureC Int      @map("temperature_c")
  humidity     Int
  darkness     Int
  notes        String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignments LairAssignment[]

  @@map("lairs")
}

/// Which monster sleeps where. releasedAt = null means "currently here".
model LairAssignment {
  id           Int       @id @default(autoincrement())
  lairId       Int       @map("lair_id")
  monsterId    Int       @map("monster_id")
  assignedById Int?      @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  releasedAt   DateTime? @map("released_at")

  lair    Lair    @relation(fields: [lairId], references: [id])
  monster Monster @relation(fields: [monsterId], references: [id])

  @@index([lairId, releasedAt])
  @@index([monsterId])
  @@map("lair_assignments")
}

model IntakeForm {
  id                 Int      @id @default(autoincrement())
  stayId             Int      @unique @map("stay_id")
  monsterId          Int      @map("monster_id")
  /// EXCELLENT | GOOD | FAIR | POOR | CRITICAL
  conditionOnArrival String   @map("condition_on_arrival") @db.VarChar(16)
  weightKg           Decimal? @map("weight_kg") @db.Decimal(8, 2)
  injuries           String?  @db.Text
  behaviourNotes     String?  @map("behaviour_notes") @db.Text
  belongings         String?  @db.Text
  receivedById       Int      @map("received_by_id")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([monsterId])
  @@map("intake_forms")
}

model MedicalRecord {
  id        Int      @id @default(autoincrement())
  monsterId Int      @map("monster_id")
  vetId     Int      @map("vet_id")
  visitDate DateTime @map("visit_date") @db.Date
  summary   String   @db.VarChar(255)
  diagnosis String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  monster       Monster        @relation(fields: [monsterId], references: [id])
  treatments    Treatment[]
  prescriptions Prescription[]

  @@index([monsterId])
  @@map("medical_records")
}

model Treatment {
  id        Int       @id @default(autoincrement())
  recordId  Int       @map("record_id")
  name      String    @db.VarChar(191)
  /// PLANNED | ONGOING | COMPLETE
  status    String    @default("PLANNED") @db.VarChar(16)
  startedAt DateTime? @map("started_at") @db.Date
  endedAt   DateTime? @map("ended_at") @db.Date
  notes     String?   @db.Text

  record MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([status])
  @@map("treatments")
}

model Prescription {
  id        Int       @id @default(autoincrement())
  recordId  Int       @map("record_id")
  remedy    String    @db.VarChar(191)
  /// POTION | SALVE | TINCTURE | POULTICE | ELIXIR
  form      String    @db.VarChar(16)
  dosage    String    @db.VarChar(100)
  frequency String    @db.VarChar(100)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  notes     String?   @db.Text

  record MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("prescriptions")
}

model Ticket {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(191)
  description String?   @db.Text
  /// OPEN | IN_PROGRESS | BLOCKED | DONE
  status      String    @default("OPEN") @db.VarChar(16)
  /// LOW | MEDIUM | HIGH | URGENT
  priority    String    @default("MEDIUM") @db.VarChar(16)
  /// MAINTENANCE | ESCAPE | CLEANING | SUPPLIES | OTHER
  category    String    @default("OTHER") @db.VarChar(16)
  assigneeId  Int?      @map("assignee_id")
  reporterId  Int       @map("reporter_id")
  lairId      Int?      @map("lair_id")
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  closedAt    DateTime? @map("closed_at")

  assignee User?           @relation("ticketAssignee", fields: [assigneeId], references: [id])
  reporter User            @relation("ticketReporter", fields: [reporterId], references: [id])
  comments TicketComment[]

  @@index([status])
  @@index([assigneeId])
  @@index([reporterId])
  @@map("tickets")
}

model TicketComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  authorId  Int      @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_comments")
}

model Supply {
  id                Int      @id @default(autoincrement())
  name              String   @unique @db.VarChar(191)
  /// FOOD | POTION | BANDAGE | BEDDING | CLEANING | OTHER
  category          String   @db.VarChar(16)
  /// kg, bottles, rolls, bales...
  unit              String   @db.VarChar(32)
  quantity          Decimal  @default(0) @db.Decimal(10, 2)
  lowStockThreshold Decimal  @default(0) @map("low_stock_threshold") @db.Decimal(10, 2)
  supplier          String?  @db.VarChar(191)
  updatedAt         DateTime @updatedAt @map("updated_at")

  movements SupplyMovement[]

  @@map("supplies")
}

model SupplyMovement {
  id        Int      @id @default(autoincrement())
  supplyId  Int      @map("supply_id")
  /// positive = delivery, negative = used/spoiled
  change    Decimal  @db.Decimal(10, 2)
  /// DELIVERY | USED | SPOILED | ADJUSTMENT
  reason    String   @db.VarChar(16)
  note      String?  @db.VarChar(255)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  supply Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@index([supplyId])
  @@map("supply_movements")
}

model StayExtension {
  id          Int      @id @default(autoincrement())
  stayId      Int      @map("stay_id")
  oldPickup   DateTime @map("old_pickup") @db.Date
  newPickup   DateTime @map("new_pickup") @db.Date
  reason      String   @db.VarChar(255)
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  stay Stay @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId])
  @@map("stay_extensions")
}

model FeedingLog {
  id        Int      @id @default(autoincrement())
  monsterId Int      @map("monster_id")
  /// the day of the schedule, not when it was ticked off
  date      DateTime @db.Date
  /// "07:00", "14:00"...
  mealTime  String   @map("meal_time") @db.VarChar(5)
  fedById   Int      @map("fed_by_id")
  fedAt     DateTime @default(now()) @map("fed_at")
  note      String?  @db.VarChar(255)

  @@unique([monsterId, date, mealTime])
  @@map("feeding_logs")
}

model HiringListing {
  id            Int      @id @default(autoincrement())
  monsterId     Int      @map("monster_id")
  title         String   @db.VarChar(191)
  pitch         String   @db.Text
  /// comma separated, e.g. "treasure guarding,intimidating roars"
  skills        String?  @db.VarChar(255)
  availableFrom DateTime @map("available_from") @db.Date
  /// asking fee in gold pieces
  feeGold       Decimal  @map("fee_gold") @db.Decimal(10, 2)
  /// DRAFT | OPEN | CLOSED
  status        String   @default("DRAFT") @db.VarChar(16)
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  monster      Monster             @relation(fields: [monsterId], references: [id])
  applications HiringApplication[]

  @@index([monsterId])
  @@index([status])
  @@map("hiring_listings")
}

model HiringApplication {
  id                 Int       @id @default(autoincrement())
  listingId          Int       @map("listing_id")
  /// the overlord's customer profile
  customerId         Int       @map("customer_id")
  message            String    @db.Text
  lairDescription    String?   @map("lair_description") @db.Text
  /// PENDING | ACCEPTED | REJECTED | WITHDRAWN
  status             String    @default("PENDING") @db.VarChar(16)
  createdAt          DateTime  @default(now()) @map("created_at")
  decidedAt          DateTime? @map("decided_at")
  decidedById        Int?      @map("decided_by_id")

  listing    HiringListing   @relation(fields: [listingId], references: [id])
  references HireReference[]
  contract   HireContract?

  @@index([listingId])
  @@index([customerId])
  @@map("hiring_applications")
}

model HireReference {
  id            Int    @id @default(autoincrement())
  applicationId Int    @map("application_id")
  refereeName   String @map("referee_name") @db.VarChar(191)
  relationship  String @db.VarChar(191)
  text          String @db.Text

  application HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("hire_references")
}

model HireContract {
  id            Int       @id @default(autoincrement())
  applicationId Int       @unique @map("application_id")
  monsterId     Int       @map("monster_id")
  customerId    Int       @map("customer_id")
  /// e.g. HH-7KQ2, printed on the parchment
  reference     String    @unique @db.VarChar(16)
  /// gold pieces
  fee           Float
  startDate     DateTime  @map("start_date") @db.Date
  terms         String    @db.Text
  signedAt      DateTime? @map("signed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  application HiringApplication @relation(fields: [applicationId], references: [id])

  @@index([monsterId])
  @@index([customerId])
  @@map("hire_contracts")
}

// ---------------------------------------------------------------------------
// Billing v2 (2024): all money in integer copper pieces. 1 gp = 100 cp.
// ---------------------------------------------------------------------------

model InvoiceV2 {
  id              Int       @id @default(autoincrement())
  /// set when the invoice was copied over from tbl_invoice
  legacyInvoiceId Int?      @unique @map("legacy_invoice_id")
  stayId          Int?      @map("stay_id")
  customerId      Int       @map("customer_id")
  /// BC-2024-000123
  number          String    @unique @db.VarChar(20)
  /// DRAFT | ISSUED | PAID | VOID
  status          String    @default("DRAFT") @db.VarChar(16)
  issuedAt        DateTime? @map("issued_at")
  dueAt           DateTime? @map("due_at") @db.Date
  subtotalCopper  Int       @default(0) @map("subtotal_copper")
  totalCopper     Int       @default(0) @map("total_copper")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lines    InvoiceLineV2[]
  payments PaymentV2[]

  @@index([customerId])
  @@index([stayId])
  @@map("invoices_v2")
}

model InvoiceLineV2 {
  id           Int    @id @default(autoincrement())
  invoiceId    Int    @map("invoice_id")
  description  String @db.VarChar(255)
  quantity     Int    @default(1)
  unitCopper   Int    @map("unit_copper")
  amountCopper Int    @map("amount_copper")
  /// STAY | TREATMENT | THERAPY | LATE_FEE | DISCOUNT | OTHER
  kind         String @default("OTHER") @db.VarChar(16)
  position     Int    @default(0)

  invoice InvoiceV2 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines_v2")
}

model PaymentV2 {
  id           Int      @id @default(autoincrement())
  invoiceId    Int      @map("invoice_id")
  amountCopper Int      @map("amount_copper")
  /// GOLD | GEMS | IOU | FAVOUR
  method       String   @db.VarChar(16)
  receivedAt   DateTime @default(now()) @map("received_at")
  receivedById Int?     @map("received_by_id")
  note         String?  @db.VarChar(255)

  invoice InvoiceV2 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments_v2")
}

model FeatureFlag {
  key         String   @id @db.VarChar(64)
  enabled     Boolean  @default(false)
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// In-app notifications for staff and customers (replaces Raven Post, ADR-007).
model Notification {
  id         Int       @id @default(autoincrement())
  /// staff member (tbl_user) OR customer, never both
  userId     Int?      @map("user_id")
  customerId Int?      @map("customer_id")
  /// IN_APP | RAVEN | CRYSTAL_BALL | EMAIL
  channel    String    @default("IN_APP") @db.VarChar(16)
  title      String    @db.VarChar(191)
  body       String    @db.Text
  link       String?   @db.VarChar(255)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([customerId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Therapy (2025)
// ---------------------------------------------------------------------------

model TherapyPlan {
  id          Int       @id @default(autoincrement())
  monsterId   Int       @map("monster_id")
  therapistId Int       @map("therapist_id")
  /// ADVENTURER_TRAUMA | FEAR_OF_TORCHES | HOARDING_ANXIETY | BRIDGE_TRAUMA | FEAR_OF_SWORDS | SEPARATION_ANXIETY | OTHER
  issue       String    @db.VarChar(32)
  goals       String    @db.Text
  /// ACTIVE | PAUSED | COMPLETED
  status      String    @default("ACTIVE") @db.VarChar(16)
  startedAt   DateTime  @map("started_at") @db.Date
  endedAt     DateTime? @map("ended_at") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  monster  Monster          @relation(fields: [monsterId], references: [id])
  sessions TherapySession[]

  @@index([monsterId])
  @@index([therapistId])
  @@map("therapy_plans")
}

model TherapySession {
  id           Int      @id @default(autoincrement())
  planId       Int      @map("plan_id")
  sessionDate  DateTime @map("session_date") @db.Date
  durationMin  Int      @default(50) @map("duration_min")
  /// 1 (terrible) .. 10 (wonderful)
  moodBefore   Int      @map("mood_before")
  moodAfter    Int      @map("mood_after")
  notes        String   @db.Text
  homework     String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  plan TherapyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("therapy_sessions")
}
